// ============================================================================
//  version_info.hpp — AUTO-GENERATED by cmake/version_info.cmake. DO NOT EDIT.
//
//  Git + semver + system + build metadata baked into the binary at configure
//  time. Every value is a `constexpr` member of the single aggregate
//  `rtos_manager::build::kMetadata` — no macros, and anything derivable (e.g.
//  "is this a pre-release") is computed by a constexpr member function instead
//  of being injected a second time.
//
//  This header is the *data*; the API around it (property accessors, text /
//  JSON rendering, logging) is rtos_manager::BuildInfo in
//  <rtos_manager/version.hpp>. Prefer that class over reading this header.
// ============================================================================
#pragma once

#include <string_view>

namespace rtos_manager::build {

/// Project identity, from project() in the top-level CMakeLists.txt.
struct Project {
  std::string_view name;
  std::string_view description;
  std::string_view homepage;
};

/// Semantic version parsed from the latest `vX.Y.Z[-pre.N]` git tag.
struct Version {
  std::string_view semver;      ///< "1.2.3", or "1.2.3-rc.4" for a pre-release
  int major;
  int minor;
  int patch;
  std::string_view preRelease;  ///< "alpha" | "beta" | "rc" | "" (stable)
  int preNum;

  /// Derived — never stored twice.
  [[nodiscard]] constexpr bool IsPrerelease() const noexcept {
    return !preRelease.empty();
  }
};

/// Git provenance recorded at configure time.
struct Git {
  std::string_view describe;    ///< `git describe --tags --always --dirty`
  std::string_view hash;        ///< full commit hash
  std::string_view hashShort;   ///< abbreviated commit hash
  std::string_view branch;      ///< branch checked out at configure time
  std::string_view tag;         ///< nearest annotated tag ("unknown" if none)
  int commitCount;              ///< total commits on HEAD
  std::string_view commitDate;  ///< ISO-8601 committer date of HEAD
  bool dirty;                   ///< working tree had uncommitted changes
};

/// Build configuration that produced the binary.
struct Build {
  std::string_view type;        ///< Debug | Release | RelWithDebInfo | MinSizeRel
  std::string_view timestamp;   ///< "YYYY-MM-DD HH:MM:SS" (UTC)
  int cxxStandard;              ///< 17 | 20 | 23 | 26
};

/// Host the binary was built on / for.
struct Host {
  std::string_view system;      ///< Linux, Windows, ...
  std::string_view version;     ///< kernel / OS version
  std::string_view processor;   ///< x86_64, aarch64, ...
};

/// Compiler that produced the binary.
struct Compiler {
  std::string_view id;          ///< GNU, Clang, MSVC, ...
  std::string_view version;     ///< e.g. 16.2.0
};

/// Single source of truth for every generated value.
struct Metadata {
  Project project;
  Version version;
  Git git;
  Build build;
  Host host;
  Compiler compiler;
};

inline constexpr Metadata kMetadata{
    .project = {.name = "@PROJECT_NAME@",
                .description = "@PROJECT_DESCRIPTION@",
                .homepage = "@PROJECT_HOMEPAGE_URL@"},
    .version = {.semver = "@RTOS_VERSION_SEMVER@",
                .major = @RTOS_VERSION_MAJOR@,
                .minor = @RTOS_VERSION_MINOR@,
                .patch = @RTOS_VERSION_PATCH@,
                .preRelease = "@RTOS_VERSION_PRE_RELEASE@",
                .preNum = @RTOS_VERSION_PRE_NUM@},
    .git = {.describe = "@RTOS_GIT_DESCRIBE@",
            .hash = "@RTOS_GIT_HASH@",
            .hashShort = "@RTOS_GIT_HASH_SHORT@",
            .branch = "@RTOS_GIT_BRANCH@",
            .tag = "@RTOS_GIT_TAG@",
            .commitCount = @RTOS_GIT_COMMIT_COUNT@,
            .commitDate = "@RTOS_GIT_COMMIT_DATE@",
            .dirty = @RTOS_GIT_DIRTY@},
    .build = {.type = "@RTOS_BUILD_TYPE@",
              .timestamp = "@RTOS_BUILD_TIME@",
              .cxxStandard = @RTOS_EFFECTIVE_CXX_STD@},
    .host = {.system = "@RTOS_SYSTEM_NAME@",
             .version = "@RTOS_SYSTEM_VER@",
             .processor = "@RTOS_SYSTEM_PROCESSOR@"},
    .compiler = {.id = "@RTOS_COMPILER_ID@", .version = "@RTOS_COMPILER_VER@"},
};

}  // namespace rtos_manager::build
