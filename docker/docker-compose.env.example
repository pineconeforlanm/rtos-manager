# ============================================================================
#  Copy to docker/.env (compose auto-loads it from the compose file's directory)
#  and edit. The values below are the built-in dev defaults, so the stack also
#  runs with no .env at all — never ship these credentials beyond localhost.
# ============================================================================

# --- Redis ---
REDIS_PASSWORD=rtos_redis_dev
REDIS_HOST_PORT=6379

# --- PostgreSQL ---
POSTGRES_DB=rtos_manager
POSTGRES_USER=rtos
POSTGRES_PASSWORD=rtos_pg_dev
POSTGRES_HOST_PORT=5432
